{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "update": "notify",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ],
        "disabled": false
      },
      "ui-browser": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--isolated"
        ],
        "disabled": false
      }
    }
  }
}
