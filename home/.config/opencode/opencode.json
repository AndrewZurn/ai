{
  "$schema": "https://opencode.ai/config.json",
  "username": "Andrew",
  "default_agent": "plan",
  "autoupdate": "notify",
  "agent": {
    "build": {
      "model": "opencode-go/gpt-5.6-luna",
    },
    "plan": {
      "mode": "primary",
      "model": "opencode-go/kimi-k3",
    }
  },
  "experimental": {
    "disable_paste_summary": true
  },
  "provider": {
    "mlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLX (local)",
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "default_model": {
          "name": "Default MLX Model"
        }
      }
    },
    "local-llama": {
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "yuxinlu1/gemma-4-12B-coder-fable5-composer2.5-v1-GGUF:Q4_K_M": {
          "id": "gemma-4 fable distilled"
        }
      }
    }
  },
  "mcp": {
    "synk": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "snyk@latest",
        "mcp",
        "-t",
        "stdio"
      ],
      "environment": {
        "SNYK_TOKEN": "{env:SNYK_TOKEN}",
        "SNYK_CFG_ORG": "{env:SNYK_CFG_ORG}"
      }
    },
    "lucid": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.lucid.app/mcp"
      ]
    },
    "datadog": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.datadoghq.com/v1/mcp?referrer_ide=opencode-plugin&plugin_version=0.7.13&toolsets=all",
      "oauth": {}
    }
  }
}
