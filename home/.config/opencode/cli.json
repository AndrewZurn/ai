{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "vercel",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show"
  },
  "animations": true,
  "prompt": {
    "paste": "compact",
    "image_preview": false
  },
  "terminal": {
    "copy": "select"
  },
  "debug": {
    "turn_tokens": false
  },
  "tabs": {
    "layout": "vertical",
    "mode": "on"
  },
  "plugins": ["./herdr-opencode"]
}
