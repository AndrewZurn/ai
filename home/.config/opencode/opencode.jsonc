{
  "$schema": "https://opencode.ai/config.json",
  "username": "Andrew",
  "default_agent": "plan",
  "update": "notify",
  "agents": {
    "build": {
      "model": "opencode-go/glm-5.3-flash"
    },
    "plan": {
      "model": "opencode-go/glm-5.3"
    }
  },
  "providers": {
    "mlx": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "MLX (local)",
      "settings": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "default_model": {
          "name": "Default MLX Model"
        }
      }
    },
    "local-llama": {
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "yuxinlu1/gemma-4-12B-coder-fable5-composer2.5-v1-GGUF:Q4_K_M": {
          "modelID": "gemma-4 fable distilled"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "synk": {
        "type": "local",
        "disabled": true,
        "command": ["npx", "-y", "snyk@latest", "mcp", "-t", "stdio"],
        "environment": {
          "SNYK_TOKEN": "{env:SNYK_TOKEN}",
          "SNYK_CFG_ORG": "{env:SNYK_CFG_ORG}"
        }
      },
      "lucid": {
        "type": "local",
        "disabled": true,
        "command": ["npx", "-y", "mcp-remote", "https://mcp.lucid.app/mcp"]
      },
      "datadog": {
        "type": "remote",
        "disabled": true,
        "url": "https://mcp.datadoghq.com/v1/mcp?referrer_ide=opencode-plugin&plugin_version=0.7.13&toolsets=all",
        "oauth": {}
      }
    }
  }
}
